<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>VT7.SshNetProbe</AssemblyName>
    <RootNamespace>VT7.SshNetProbe</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>$(VT7BinaryRoot)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <RestoreAdditionalProjectSources>$(VT7RepositoryRoot)dep\packages</RestoreAdditionalProjectSources>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\..\..\artifacts\vt7\deps\nuget</RestorePackagesPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="[2026.0.1-prerelease.6]" />
    <Reference Include="System.Web.Extensions" />
    <None Update="fixtures\s01-encrypted-test-key" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\s01-encrypted-test-key.pub" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
