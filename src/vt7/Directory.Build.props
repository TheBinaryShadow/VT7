<Project>
  <PropertyGroup>
    <VT7RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</VT7RepositoryRoot>
    <VT7ArtifactsRoot>$(VT7RepositoryRoot)artifacts\vt7\</VT7ArtifactsRoot>
    <VT7BinaryRoot>$(VT7ArtifactsRoot)bin\$(Configuration)\</VT7BinaryRoot>
    <VT7IntermediateRoot>$(VT7ArtifactsRoot)obj\$(MSBuildProjectName)\$(Configuration)\</VT7IntermediateRoot>

    <BaseIntermediateOutputPath>$(VT7ArtifactsRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(VT7IntermediateRoot)</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(VT7IntermediateRoot)</MSBuildProjectExtensionsPath>

    <Product>VT7</Product>
    <Company>VT7 contributors</Company>
    <Authors>VT7 contributors</Authors>
    <Copyright>Copyright (c) 2026 VT7 contributors</Copyright>
    <Version>0.3.4</Version>
    <VersionPrefix>0.3.4</VersionPrefix>
    <AssemblyVersion>0.3.4.0</AssemblyVersion>
    <FileVersion>0.3.4.0</FileVersion>
    <InformationalVersion>0.3.4-atlas-scaling-correction</InformationalVersion>

    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugSymbols>true</DebugSymbols>
    <LangVersion>latestMajor</LangVersion>
  </PropertyGroup>
</Project>
