<Application x:Class="VT7.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#101821" />
        <SolidColorBrush x:Key="PanelBackground" Color="#182533" />
        <SolidColorBrush x:Key="PanelBorder" Color="#35516D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#65B8FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B8C9D9" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F7FA" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2675B8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#79C7FF" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
